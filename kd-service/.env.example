# Puerto interno donde escucha FastAPI (loopback). Debe coincidir con KD_BASE_URL del Node.
PORT=8001

# Entorno: development | production
ENV=production

# Nivel de logs: debug | info | warning | error
LOG_LEVEL=info

# API key compartida con el backend Node. Debe coincidir EXACTAMENTE con KD_API_KEY de server/.env.
# Genera una nueva con:  openssl rand -hex 32
API_KEY=

# Ruta absoluta o relativa al fichero cookies.json con la sesion DWR del portal.
# Fallback / break-glass: se usa solo si el session_keeper no esta configurado
# o no responde. Mientras el keeper este vivo, este fichero ni se toca.
COOKIES_PATH=./cookies.json

# --- session_keeper (fuente preferida de cookies DWR) -----------------------
# URL del servicio que mantiene login con el .p12 y refresca cookies en
# background. Si esta definido, kd-service le pide cookies al arrancar y
# cuando la sesion expira. Si no responde, cae al cookies.json de arriba.
# Dejar vacio para desactivar.
SESSION_KEEPER_URL=http://127.0.0.1:8080

# Token X-Admin-Key que pide el endpoint GET {URL}/cookies del keeper.
ADMIN_API_KEY=

# Timeout (segundos) de las llamadas al keeper.
SESSION_KEEPER_TIMEOUT_S=10

# Edad maxima de las cookies cacheadas en memoria antes de re-pedirlas al
# keeper de forma proactiva (segundos). 0 = nunca (solo bajo demanda).
SESSION_KEEPER_MAX_AGE_S=600

# Origen(es) permitidos por CORS. Por defecto NINGUNO porque solo deberia
# llamarte el Node por loopback. Solo descomentar si quieres pegarle directamente
# desde el navegador en debug.
# CORS_ORIGINS=http://localhost:5173
