# --- VoIPstudio ---
# API key del panel de VoIPstudio (sección "API Keys")
VOIP_STUDIO_API_KEY=

# user_id del agente fijo que recibirá la llamada (no es la extensión, es el "id" del usuario)
# Se obtiene con: curl https://l7api.com/v1.2/voipstudio/users -H "X-Auth-Token: $VOIP_STUDIO_API_KEY"
# Solo se usa si VOIP_QUEUE_ID está vacío.
VOIP_DEFAULT_AGENT_ID=

# Modo cola: id de la cola en VoIPstudio. Si está definido, el backend lee
# sus miembros y los intenta secuencialmente (cada miembro como `from` en POST /calls)
# hasta que uno acepte (201). Si todos devuelven 412, responde "agente no disponible".
# Si está vacío, se usa VOIP_DEFAULT_AGENT_ID (modo single-agent).
# Se obtiene con: curl https://l7api.com/v1.2/voipstudio/queues -H "X-Auth-Token: $VOIP_STUDIO_API_KEY"
VOIP_QUEUE_ID=

# Máximo de miembros a intentar por petición (default: 3). Limita la espera total
# si hay muchos agentes offline (cada 412 cuesta ~10s).
# VOIP_QUEUE_MAX_ATTEMPTS=3

# --- Opcionales ---
# URL base de la API (default: https://l7api.com/v1.2/voipstudio)
# VOIPSTUDIO_API_URL=

# Puerto del servidor (default: 3000)
# PORT=3000

# Máximo de intentos por IP cada 10 min (default: 3). Ponlo a 0 para desactivar.
# RATE_LIMIT_MAX=3
